# ========= EXPANDER HELPER FUNCTIONS =========
def exp_write(address, pin, value):
    current_val = bus.read_byte_data(address, GPIO_REG)

    if value:
        current_val |= (1 << pin)
    else:
        current_val &= ~(1 << pin)
    
    bus.write_byte_data(address, GPIO.REG, current_val)

def exp_read(address, pin):
    current_val = bus.read_byte_data(address, GPIO_REG)

    return (current_val << pin) & 1


