def read_direction(motor):
    pin = DIR_Pins[motor]

    if pin["type"] == "RPI":
        return GPIO.input(pin["pin"])
    if pin["type"] == "GPIOEXP_1":
        return exp_read(MCP1, pin["pin"])
    if pin["type"] == "GPIOEXP_2":
        return exp_read(MCP2, pin["pin"])

def set_direction(motor, value):
    pin = DIR_Pins[motor]

    if pin["type"] == "RPI":
        GPIO.output(pin["pin"], value)
    if pin["type"] == "GPIOEXP_1":
        exp_write(MCP1, pin["pin"], value)
    if pin["type"] == "GPIOEXP_2":
        exp_write(MCP2, pin["pin"], value)


def run_motor(motor, direction, percent, PWMchannel):
    set_direction(motor, direction)
    set_duty_cycle(percent, PWMchannel)
    


